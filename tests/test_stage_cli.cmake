if(NOT DEFINED LIFTER OR NOT DEFINED WORK)
  message(FATAL_ERROR "LIFTER and WORK are required")
endif()
file(MAKE_DIRECTORY "${WORK}/stages/nested")
file(WRITE "${WORK}/stages/nested/encrypted.PRX" "~SCE fixture")
file(WRITE "${WORK}/not-elf.prx" "invalid fixture")
foreach(mode directory explicit empty missing)
  if(mode STREQUAL directory)
    set(args --stage-dir "${WORK}/stages")
    set(expected "unsupported/encrypted stage")
  elseif(mode STREQUAL explicit)
    set(args --stage "${WORK}/not-elf.prx")
    set(expected "unsupported/encrypted stage")
  elseif(mode STREQUAL empty)
    file(MAKE_DIRECTORY "${WORK}/empty")
    set(args --stage-dir "${WORK}/empty")
    set(expected "no stage PRX modules")
  else()
    set(args --stage-dir "${WORK}/missing")
    set(expected "stage directory is missing")
  endif()
  execute_process(COMMAND "${LIFTER}" "${WORK}/not-elf.prx" "${WORK}/out" ${args}
                  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 1 OR NOT "${error}" MATCHES "${expected}")
    message(FATAL_ERROR "${mode}: unexpected result ${result}: ${output}${error}")
  endif()
  if(EXISTS "${WORK}/out/stages.manifest")
    message(FATAL_ERROR "failed stage validation wrote a completed manifest")
  endif()
endforeach()
file(REMOVE "${WORK}/stages/nested/encrypted.PRX" "${WORK}/not-elf.prx")
file(REMOVE_RECURSE "${WORK}/stages" "${WORK}/empty")
